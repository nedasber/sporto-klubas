# AUTH FORMS / VALIDATORS
# ============================================================
msgid "Įveskite teisingą el. pašto adresą."
msgstr "Enter a valid email address."

msgid "Privaloma. Iki 150 simbolių. Tik raidės, skaitmenys ir @/./+/-/_."
msgstr "Required. Up to 150 characters. Only letters, digits and @/./+/-/_."

msgid "Įveskite vartotojo vardą."
msgstr "Enter a username."

msgid "Toks vartotojo vardas jau egzistuoja."
msgstr "A user with that username already exists."

msgid "Vartotojo vardas negali būti ilgesnis nei 150 simbolių."
msgstr "Username cannot be longer than 150 characters."

msgid "Vartotojo varde gali būti tik raidės, skaitmenys ir simboliai @/./+/-/_."
msgstr "Username may only contain letters, digits and @/./+/-/_."

msgid "Slaptažodis turi būti bent 8 simbolių ilgio. Negali būti panašus į kitus jūsų asmeninius duomenis. Negali būti dažnai naudojamas slaptažodis. Negali būti sudarytas vien tik iš skaitmenų."
msgstr "The password must be at least 8 characters long. It cannot be too similar to your personal information. It cannot be a commonly used password. It cannot be entirely numeric."

msgid "Įveskite slaptažodį."
msgstr "Enter a password."

msgid "Pakartokite tą patį slaptažodį patikrinimui."
msgstr "Repeat the same password for verification."

msgid "Pakartokite slaptažodį."
msgstr "Repeat the password."

msgid "Slaptažodžiai nesutampa."
msgstr "Passwords do not match."

msgid "Neteisingas vartotojo vardas arba slaptažodis. Patikrinkite ar teisingai įvedėte (atkreipkite dėmesį, kad svarbu didžiosios/mažosios raidės)."
msgstr "Incorrect username or password. Please check (note that uppercase and lowercase letters matter)."

msgid "Ši paskyra yra neaktyvi."
msgstr "This account is inactive."

msgid "Slaptažodis per trumpas. Jis turi būti bent %(min_length)d simbolių ilgio."
msgstr "Password is too short. It must be at least %(min_length)d characters long."

msgid "Slaptažodis turi būti bent %(min_length)d simbolių ilgio."
msgstr "Password must be at least %(min_length)d characters long."

msgid "Slaptažodis pernelyg panašus į jūsų asmeninius duomenis (vartotojo vardą, el. paštą ir pan.)."
msgstr "The password is too similar to your personal information (username, email, etc.)."

msgid "Slaptažodis negali būti panašus į kitus jūsų asmeninius duomenis."
msgstr "Password cannot be too similar to your personal information."

msgid "Šis slaptažodis pernelyg dažnai naudojamas. Pasirinkite saugesnį."
msgstr "This password is too common. Please choose a safer one."

msgid "Slaptažodis negali būti dažnai naudojamas (pvz. 'password', '12345678')."
msgstr "Password cannot be commonly used (e.g. 'password', '12345678')."

msgid "Slaptažodis negali būti sudarytas vien tik iš skaitmenų."
msgstr "Password cannot be entirely numeric."

